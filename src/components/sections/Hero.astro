---
import ProductWindow from "~/components/ProductWindow.astro";
import { getLatestRelease } from "~/lib/releases";

const release = await getLatestRelease();
---

<section class="hero" id="top" data-hero>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__orb" aria-hidden="true"></div>
  <div class="shell hero__inner">
    <div class="hero__copy">
      <div class="hero__signature">
        <svg class="hero__mark" viewBox="0 0 1024 1024" aria-hidden="true">
          <g class="hero__mark-bars">
            <rect x="288" y="272" width="72" height="480" />
            <rect x="416" y="272" width="72" height="480" />
            <rect x="544" y="272" width="72" height="480" />
            <rect x="672" y="272" width="72" height="480" />
          </g>
          <line class="hero__mark-slash" x1="232" y1="680" x2="792" y2="420" />
        </svg>
        <span><span data-lang="en">Desktop productivity, without the noise</span><span data-lang="fr">La productivité desktop, sans le bruit</span></span>
      </div>

      <h1>
        <span data-lang="en">Your day. <em class="gradient-text">Finally clear.</em></span>
        <span data-lang="fr">Ta journée. <em class="gradient-text">Enfin claire.</em></span>
      </h1>

      <p class="hero__lede">
        <span data-lang="en">Manager brings your day into one calm desktop app—from the first task to the last note.</span>
        <span data-lang="fr">Manager réunit ta journée dans une application desktop calme, de la première tâche à la dernière note.</span>
      </p>

      <div class="hero__actions">
        <a class="hero__primary button-shine" href={release.winUrl}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 4.8 10.7 4v7.4H3.5zm8.5-1 8.5-1v8.6H12zM3.5 12.7h7.2V20l-7.2-.8zm8.5 0h8.5v8.5l-8.5-1z" /></svg>
          <span data-lang="en">Download for PC</span><span data-lang="fr">Télécharger pour PC</span>
        </a>
        <a class="hero__secondary" href="#overview">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 5 5 5-5 5" /></svg>
          <span data-lang="en">See the interface</span><span data-lang="fr">Voir l’interface</span>
        </a>
      </div>

      <p class="hero__meta">
        <span class="hero__status" aria-hidden="true"></span>
        <span data-lang="en">Free · Windows 10/11 · Linux · v{release.version}</span>
        <span data-lang="fr">Gratuit · Windows 10/11 · Linux · v{release.version}</span>
      </p>
    </div>

    <div class="hero__visual" data-hero-visual>
      <div class="hero__beam" aria-hidden="true"></div>
      <div class="hero__pedestal" aria-hidden="true"><i></i></div>
      <div class="hero__device" data-hero-product>
        <div class="hero__tilt" data-hero-tilt>
          <ProductWindow
            src="/screenshots/dashboard.png"
            altEn="Manager dashboard showing a 25-minute focus timer, today's tasks, progress, current focus and schedule."
            altFr="Dashboard de Manager avec un chronomètre de 25 minutes, les tâches du jour, la progression, le focus actuel et le planning."
            captionId="hero-dashboard"
            eager
          />
        </div>
      </div>
      <div class="hero__badge hero__badge--focus" aria-hidden="true">
        <span>Focus</span><strong>25:00</strong><i></i>
      </div>
      <div class="hero__badge hero__badge--local" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 6h14v10H5zM9 20h6M12 16v4" /></svg>
        <span><span data-lang="en">Local by default</span><span data-lang="fr">Local par défaut</span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(62rem, 100svh); padding: clamp(7.5rem, 11vw, 9.5rem) 0 clamp(4rem, 7vw, 6rem); overflow: clip; isolation: isolate; }
  .hero__grid { position: absolute; inset: 0; z-index: -3; background-image: linear-gradient(90deg, var(--grid-line) 1px, transparent 1px), linear-gradient(var(--grid-line) 1px, transparent 1px); background-size: 4.5rem 4.5rem; -webkit-mask-image: linear-gradient(to bottom, black, transparent 88%); mask-image: linear-gradient(to bottom, black, transparent 88%); }
  .hero__orb { position: absolute; top: -25rem; right: -18rem; z-index: -2; width: min(74rem, 95vw); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 24%, transparent), color-mix(in srgb, var(--accent-2) 8%, transparent) 44%, transparent 70%); filter: blur(1.5rem); }
  .hero__inner { display: grid; grid-template-columns: minmax(24rem, 0.82fr) minmax(34rem, 1.18fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .hero__copy { position: relative; z-index: 3; padding-block: 2rem; }
  .hero__signature { display: inline-flex; align-items: center; gap: 0.8rem; color: var(--mute); font-family: var(--font-mono); font-size: 0.66rem; font-weight: 750; letter-spacing: 0.095em; text-transform: uppercase; opacity: 0; animation: hero-copy-in 760ms var(--ease-out) 80ms forwards; }
  .hero__mark { width: 2.6rem; overflow: visible; color: var(--ink); }
  .hero__mark-bars { fill: currentColor; }
  .hero__mark-bars rect { transform: scaleY(0); transform-box: fill-box; transform-origin: 50% 100%; animation: mark-bar 480ms var(--ease-out) forwards; }
  .hero__mark-bars rect:nth-child(2) { animation-delay: 70ms; }
  .hero__mark-bars rect:nth-child(3) { animation-delay: 140ms; }
  .hero__mark-bars rect:nth-child(4) { animation-delay: 210ms; }
  .hero__mark-slash { fill: none; stroke: currentColor; stroke-width: 48; stroke-dasharray: 620; stroke-dashoffset: 620; animation: mark-slash 540ms var(--ease-out) 310ms forwards; }
  .hero h1 { max-width: 13ch; margin-top: clamp(1.6rem, 3vw, 2.2rem); font-size: clamp(3.5rem, 5.35vw, 5.65rem); line-height: 0.94; opacity: 0; animation: hero-copy-in 900ms var(--ease-out) 160ms forwards; }
  .hero h1 em { display: block; margin-top: 0.12em; font-style: normal; }
  .hero__lede { max-width: 35rem; margin-top: clamp(1.5rem, 3vw, 2.15rem); color: var(--mute); font-size: clamp(1rem, 1.3vw, 1.18rem); line-height: 1.7; opacity: 0; animation: hero-copy-in 820ms var(--ease-out) 280ms forwards; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.8rem, 3vw, 2.45rem); opacity: 0; animation: hero-copy-in 820ms var(--ease-out) 380ms forwards; }
  .hero__primary, .hero__secondary { display: inline-flex; align-items: center; justify-content: center; gap: 0.72rem; min-height: 3.35rem; padding: 0.9rem 1.3rem; border-radius: 0.82rem; font-size: 0.83rem; font-weight: 750; transition: transform var(--dur-press) var(--ease-out), border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
  .hero__primary { background: linear-gradient(105deg, #5275ff, #8565f5); color: #fff; box-shadow: 0 1.2rem 3.2rem rgb(70 91 216 / 0.27); }
  .hero__primary:hover { box-shadow: 0 1.35rem 3.5rem rgb(70 91 216 / 0.38); transform: translateY(-2px); }
  .hero__primary svg { width: 1.08rem; fill: currentColor; }
  .hero__secondary { border: 1px solid var(--rule-strong); background: var(--surface-glass); color: var(--ink-warm); }
  .hero__secondary:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--rule)); background: var(--surface-hover); }
  .hero__secondary svg { width: 0.95rem; fill: none; stroke: currentColor; stroke-width: 1.65; }
  .hero__primary:active, .hero__secondary:active { transform: scale(0.98); }
  .hero__meta { display: flex; align-items: center; gap: 0.55rem; margin-top: 1rem; color: var(--mute-soft); font-size: 0.7rem; font-weight: 650; opacity: 0; animation: hero-copy-in 800ms var(--ease-out) 470ms forwards; }
  .hero__status { width: 0.42rem; aspect-ratio: 1; border-radius: 50%; background: #5cdb97; box-shadow: 0 0 0 0.24rem rgb(92 219 151 / 0.12); }

  .hero__visual { position: relative; min-height: clamp(34rem, 51vw, 47rem); perspective: 1400px; opacity: 0; animation: hero-visual-in 1200ms var(--ease-out) 260ms forwards; }
  .hero__beam { position: absolute; top: 7%; right: -15%; width: 95%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 68%); filter: blur(2.5rem); animation: beam-breathe 7s ease-in-out infinite; }
  .hero__pedestal { position: absolute; right: -5%; bottom: 2%; width: 87%; height: 24%; border: 1px solid rgb(117 139 255 / 0.24); border-radius: 50%; background: linear-gradient(180deg, #111724, #060810 58%); box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 0.5), 0 -0.2rem 1.2rem rgb(95 124 255 / 0.25) inset; transform: rotateX(64deg); }
  .hero__pedestal i { position: absolute; inset: 7% 9%; border-radius: inherit; border-top: 2px solid rgb(99 129 255 / 0.66); box-shadow: 0 -0.4rem 1.2rem rgb(79 110 255 / 0.48); }
  .hero__device { position: absolute; top: 9%; right: -6%; width: 105%; transform: translate3d(0, var(--hero-shift, 0), 0); }
  .hero__tilt { transform: rotateX(calc(2deg + var(--tilt-x, 0deg))) rotateY(calc(-10deg + var(--tilt-y, 0deg))) rotateZ(0.4deg); transform-origin: 52% 75%; transition: transform 180ms ease-out; animation: device-float 7s ease-in-out 1.6s infinite; }
  .hero__tilt :global(.product-window) { box-shadow: -2rem 3rem 7rem rgb(0 0 0 / 0.52), 0 0 0 1px rgb(255 255 255 / 0.04) inset; }
  .hero__badge { position: absolute; z-index: 4; display: flex; align-items: center; border: 1px solid rgb(255 255 255 / 0.13); background: rgb(11 15 25 / 0.86); box-shadow: 0 1.3rem 3.5rem rgb(0 0 0 / 0.35); backdrop-filter: blur(16px); color: #eef2fb; }
  .hero__badge--focus { right: -1%; bottom: 19%; gap: 0.6rem; padding: 0.75rem 0.9rem; border-radius: 0.8rem; font-size: 0.65rem; }
  .hero__badge--focus strong { font-size: 1rem; }
  .hero__badge--focus i { width: 0.42rem; aspect-ratio: 1; border-radius: 50%; background: #6ddfa0; box-shadow: 0 0 0 0.2rem rgb(109 223 160 / 0.13); }
  .hero__badge--local { bottom: 7%; left: 5%; gap: 0.6rem; padding: 0.7rem 0.85rem; border-radius: 999px; color: #bdc5d6; font-size: 0.67rem; font-weight: 700; }
  .hero__badge--local svg { width: 1rem; fill: none; stroke: #8ba3ff; stroke-width: 1.5; }

  @keyframes mark-bar { to { transform: scaleY(1); } }
  @keyframes mark-slash { to { stroke-dashoffset: 0; } }
  @keyframes hero-copy-in { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }
  @keyframes hero-visual-in { from { opacity: 0; transform: translate3d(3rem, 2rem, 0) scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes device-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -0.55rem; } }
  @keyframes beam-breathe { 0%, 100% { opacity: 0.7; transform: scale(0.96); } 50% { opacity: 1; transform: scale(1.04); } }

  @media (max-width: 1080px) {
    .hero { min-height: auto; }
    .hero__inner { grid-template-columns: minmax(20rem, 0.85fr) minmax(30rem, 1.15fr); gap: 1rem; }
    .hero__device { right: -16%; width: 115%; }
    .hero__badge { display: none; }
  }

  @media (max-width: 820px) {
    .hero { padding-top: 8rem; }
    .hero__inner { grid-template-columns: 1fr; }
    .hero__copy { max-width: 42rem; padding-bottom: 0; }
    .hero h1 { max-width: 11ch; font-size: clamp(3.4rem, 11vw, 5.5rem); }
    .hero__visual { min-height: clamp(25rem, 75vw, 38rem); margin-top: 1rem; }
    .hero__device { top: 8%; right: 0; width: 100%; }
    .hero__pedestal { right: 0; bottom: 0; width: 92%; }
  }

  @media (max-width: 520px) {
    .hero { padding-top: 7rem; }
    .hero__signature { font-size: 0.58rem; letter-spacing: 0.06em; }
    .hero__mark { width: 2.2rem; }
    .hero h1 { font-size: clamp(3rem, 15vw, 4.35rem); }
    .hero__actions { flex-direction: column; }
    .hero__primary, .hero__secondary { width: 100%; }
    .hero__visual { min-height: 19.5rem; }
    .hero__device { top: 12%; right: auto; left: -3%; width: 106%; }
    .hero__pedestal { right: -3%; bottom: -3%; width: 106%; }
    .hero__tilt { transform: rotateX(1deg) rotateY(-3deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__signature, .hero h1, .hero__lede, .hero__actions, .hero__meta, .hero__visual { opacity: 1; animation: none; transform: none; }
    .hero__mark-bars rect { animation: none; transform: scaleY(1); }
    .hero__mark-slash { animation: none; stroke-dashoffset: 0; }
    .hero__tilt { animation: none; }
    .hero__beam { animation: none; }
  }
</style>
