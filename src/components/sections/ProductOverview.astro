---
import ProductWindow from "~/components/ProductWindow.astro";
---

<section class="overview" id="overview" aria-labelledby="overview-title">
  <div class="shell overview__panel theme-surface">
    <div class="overview__copy" data-appear="left">
      <span class="eyebrow"><span data-lang="en">One daily workspace</span><span data-lang="fr">Un seul espace quotidien</span></span>
      <h2 id="overview-title">
        <span data-lang="en">Your day, readable <em class="gradient-text">at a glance.</em></span>
        <span data-lang="fr">Ta journée, lisible <em class="gradient-text">en un coup d’œil.</em></span>
      </h2>
      <p>
        <span data-lang="en">Move from priorities to deep work without rebuilding your context every time.</span>
        <span data-lang="fr">Passe des priorités au travail de fond sans reconstruire ton contexte à chaque fois.</span>
      </p>
      <ul>
        <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg><span data-lang="en">Daily overview and task priorities</span><span data-lang="fr">Vue du jour et priorités des tâches</span></li>
        <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg><span data-lang="en">Reusable weekly schedule</span><span data-lang="fr">Planning hebdomadaire réutilisable</span></li>
        <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg><span data-lang="en">Focus history and progress trends</span><span data-lang="fr">Historique de focus et tendances</span></li>
        <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg><span data-lang="en">Private journal stored on your computer</span><span data-lang="fr">Journal privé stocké sur ton ordinateur</span></li>
      </ul>
      <a href="#experience">
        <span data-lang="en">Explore every screen</span><span data-lang="fr">Explorer chaque écran</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="overview__scene" data-appear="right" data-parallax-scene>
      <div class="overview__glow" aria-hidden="true"></div>
      <div class="overview__main" data-parallax-layer data-parallax-speed="8">
        <ProductWindow
          src="/screenshots/progress.png"
          altEn="Manager Progress screen with task completion and focus-time charts, streak and personal records."
          altFr="Écran Progression de Manager avec les graphiques des tâches et du temps de focus, la série et les records."
          captionId="overview-progress"
        />
      </div>
      <div class="overview__schedule" data-parallax-layer data-parallax-speed="18">
        <ProductWindow
          src="/screenshots/schedule.png"
          altEn="Manager weekly schedule with colored work blocks arranged throughout the week."
          altFr="Planning hebdomadaire de Manager avec des blocs de travail colorés répartis dans la semaine."
          captionId="overview-schedule"
        />
      </div>
      <div class="overview__focus" data-parallax-layer data-parallax-speed="-10">
        <ProductWindow
          src="/screenshots/focus.png"
          altEn="Manager Focus screen with a 25-minute timer and session history."
          altFr="Écran Focus de Manager avec un chronomètre de 25 minutes et l’historique des sessions."
          captionId="overview-focus"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .overview { padding: clamp(4rem, 8vw, 7rem) 0 var(--section-space); overflow: clip; scroll-margin-top: 5rem; }
  .overview__panel { position: relative; display: grid; grid-template-columns: minmax(19rem, 0.72fr) minmax(0, 1.28fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding: clamp(2rem, 5vw, 4.8rem); overflow: hidden; border: 1px solid var(--rule); border-radius: clamp(1.25rem, 3vw, 2.3rem); background: linear-gradient(145deg, var(--surface), color-mix(in srgb, var(--paper-raised) 66%, transparent)); box-shadow: var(--shadow-soft); }
  .overview__panel::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(90deg, var(--grid-line) 1px, transparent 1px), linear-gradient(var(--grid-line) 1px, transparent 1px); background-size: 3.7rem 3.7rem; -webkit-mask-image: linear-gradient(90deg, transparent, black); mask-image: linear-gradient(90deg, transparent, black); }
  .overview__copy { position: relative; z-index: 3; }
  .overview__copy h2 { max-width: 11ch; margin-top: 1.35rem; font-size: clamp(2.65rem, 4.5vw, 4.45rem); }
  .overview__copy h2 em { display: block; font-style: normal; }
  .overview__copy > p { max-width: 31rem; margin-top: 1.4rem; color: var(--mute); font-size: clamp(0.96rem, 1.2vw, 1.1rem); line-height: 1.7; }
  .overview__copy ul { display: grid; gap: 0.72rem; margin-top: 1.7rem; }
  .overview__copy li { display: flex; align-items: center; gap: 0.7rem; color: var(--ink-warm); font-size: 0.78rem; }
  .overview__copy li svg { flex: 0 0 auto; width: 1.15rem; fill: none; stroke: var(--accent); stroke-width: 1.8; }
  .overview__copy > a { display: inline-flex; align-items: center; gap: 0.75rem; margin-top: 1.8rem; color: var(--accent); font-size: 0.78rem; font-weight: 750; }
  .overview__copy > a span:last-child { transition: transform var(--dur-base) var(--ease-out); }
  .overview__copy > a:hover span:last-child { transform: translateX(0.35rem); }

  .overview__scene { position: relative; min-height: clamp(33rem, 48vw, 44rem); perspective: 1300px; }
  .overview__glow { position: absolute; inset: 10% -8% 0; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 17%, transparent), transparent 68%); filter: blur(3.5rem); }
  .overview__main { position: absolute; top: 5%; left: 0; width: 97%; transform: perspective(1200px) rotateY(-3deg) translateY(var(--layer-shift, 0)); transition: transform 650ms var(--ease-out); }
  .overview__schedule { position: absolute; right: -11%; bottom: 0; z-index: 3; width: 64%; transform: perspective(1000px) rotateY(-2deg) translateY(var(--layer-shift, 0)); transition: transform 650ms var(--ease-out); }
  .overview__focus { position: absolute; bottom: 3%; left: -7%; z-index: 4; width: 35%; transform: perspective(1000px) rotateY(4deg) translateY(var(--layer-shift, 0)); transition: transform 650ms var(--ease-out); }
  .overview__schedule :global(.product-window), .overview__focus :global(.product-window) { box-shadow: -1.5rem 2rem 5rem rgb(0 0 0 / 0.5); }
  .overview__scene:hover .overview__main { transform: perspective(1200px) rotateY(-1deg) translateY(calc(var(--layer-shift, 0px) - 0.35rem)); }
  .overview__scene:hover .overview__schedule { transform: perspective(1000px) rotateY(0) translate3d(0.3rem, calc(var(--layer-shift, 0px) - 0.65rem), 0); }
  .overview__scene:hover .overview__focus { transform: perspective(1000px) rotateY(1deg) translate3d(-0.3rem, calc(var(--layer-shift, 0px) - 0.3rem), 0); }

  @media (max-width: 940px) {
    .overview__panel { grid-template-columns: 1fr; }
    .overview__copy { max-width: 39rem; }
    .overview__scene { min-height: clamp(31rem, 70vw, 42rem); }
    .overview__main { width: 90%; }
    .overview__schedule { right: -4%; width: 57%; }
    .overview__focus { left: 1%; width: 32%; }
  }

  @media (max-width: 620px) {
    .overview__panel { padding: 1.3rem; border-radius: 1.25rem; }
    .overview__copy { padding: 1rem 0.3rem; }
    .overview__copy h2 { font-size: clamp(2.45rem, 12vw, 3.45rem); }
    .overview__scene { display: grid; gap: 1rem; min-height: 0; padding-top: 1rem; }
    .overview__main, .overview__schedule { position: relative; inset: auto; width: 100%; transform: none; }
    .overview__focus { display: none; }
    .overview__scene:hover .overview__main, .overview__scene:hover .overview__schedule { transform: none; }
  }
</style>
