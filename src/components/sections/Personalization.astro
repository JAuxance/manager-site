---
import ProductWindow from "~/components/ProductWindow.astro";
---

<section class="personal" aria-labelledby="personal-title">
  <div class="shell personal__panel theme-surface">
    <div class="personal__visual" data-appear="left">
      <div class="personal__glow" aria-hidden="true"></div>
      <ProductWindow
        src="/screenshots/themes.png"
        altEn="Manager Settings showing system, light and dark appearances, four accent themes and interface density."
        altFr="Réglages de Manager avec les apparences système, claire et sombre, quatre accents et la densité de l’interface."
      />
      <div class="personal__float" aria-hidden="true">
        <i></i><span><span data-lang="en">Follows your system</span><span data-lang="fr">Suit ton système</span></span>
      </div>
    </div>

    <div class="personal__copy" data-appear="right">
      <span class="eyebrow"><span data-lang="en">Your interface</span><span data-lang="fr">Ton interface</span></span>
      <h2 id="personal-title">
        <span data-lang="en">Light or dark. <em class="gradient-text">Still yours.</em></span>
        <span data-lang="fr">Clair ou sombre. <em class="gradient-text">Toujours à toi.</em></span>
      </h2>
      <p>
        <span data-lang="en">Manager can follow your computer automatically. Choose the appearance, accent and density that keep the interface comfortable.</span>
        <span data-lang="fr">Manager peut suivre automatiquement ton ordinateur. Choisis l’apparence, l’accent et la densité qui rendent l’interface confortable.</span>
      </p>

      <div class="personal__theme-choice" role="group" aria-label="Website theme / Thème du site">
        <button type="button" data-theme-choice="dark" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.2 8.2 0 1 0 11.2 11.2Z" /></svg>
          <span data-lang="en">Dark</span><span data-lang="fr">Sombre</span>
        </button>
        <button type="button" data-theme-choice="light" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2" /><path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M18.5 5.5l-1.4 1.4M6.9 17.1l-1.4 1.4" /></svg>
          <span data-lang="en">Light</span><span data-lang="fr">Clair</span>
        </button>
      </div>

      <div class="personal__facts">
        <div><strong>3</strong><span><span data-lang="en">appearance modes</span><span data-lang="fr">modes d’apparence</span></span></div>
        <div><strong>4</strong><span><span data-lang="en">accent themes</span><span data-lang="fr">thèmes d’accent</span></span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .personal { padding: var(--section-space) 0; overflow: clip; }
  .personal__panel { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.75fr); gap: clamp(2.5rem, 7vw, 6.5rem); align-items: center; padding: clamp(1.25rem, 4vw, 3.5rem); border: 1px solid var(--rule); border-radius: clamp(1.25rem, 3vw, 2.2rem); background: linear-gradient(130deg, color-mix(in srgb, var(--surface-2) 56%, transparent), var(--surface)); box-shadow: var(--shadow-soft); }
  .personal__visual { position: relative; z-index: 1; min-width: 0; perspective: 1200px; }
  .personal__visual :global(.product-window) { transform: rotateY(3deg) rotateX(1deg); transition: transform 650ms var(--ease-out); }
  .personal__visual:hover :global(.product-window) { transform: rotateY(0) rotateX(0) translateY(-0.3rem); }
  .personal__glow { position: absolute; inset: 8% 3% -8%; z-index: -1; border-radius: 50%; background: color-mix(in srgb, var(--accent-2) 15%, transparent); filter: blur(4rem); }
  .personal__float { position: absolute; right: -1rem; bottom: -1.2rem; display: flex; align-items: center; gap: 0.55rem; padding: 0.75rem 0.9rem; border: 1px solid rgb(255 255 255 / 0.13); border-radius: 999px; background: rgb(11 15 25 / 0.88); box-shadow: 0 1.2rem 3rem rgb(0 0 0 / 0.35); backdrop-filter: blur(14px); color: #cdd4e2; font-size: 0.65rem; font-weight: 700; }
  .personal__float i { width: 0.45rem; aspect-ratio: 1; border-radius: 50%; background: #6fd99e; box-shadow: 0 0 0 0.2rem rgb(111 217 158 / 0.14); }
  .personal__copy h2 { max-width: 10ch; margin-top: 1.3rem; font-size: var(--display-3); }
  .personal__copy h2 em { display: block; font-style: normal; }
  .personal__copy > p { max-width: 32rem; margin-top: 1.45rem; color: var(--mute); font-size: clamp(0.96rem, 1.25vw, 1.08rem); line-height: 1.7; }
  .personal__theme-choice { display: inline-grid; grid-template-columns: repeat(2, 1fr); gap: 0.35rem; margin-top: 1.65rem; padding: 0.3rem; border: 1px solid var(--rule); border-radius: 0.85rem; background: var(--paper); }
  .personal__theme-choice button { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-width: 6.5rem; min-height: 2.65rem; padding: 0.65rem 0.85rem; border-radius: 0.62rem; color: var(--mute); font-size: 0.72rem; font-weight: 750; transition: color var(--dur-fast), background var(--dur-base), box-shadow var(--dur-base); }
  .personal__theme-choice button:hover { color: var(--ink); }
  .personal__theme-choice button[aria-pressed="true"] { background: var(--surface); color: var(--ink); box-shadow: 0 0.45rem 1.5rem rgb(0 0 0 / 0.1), 0 0 0 1px var(--rule); }
  .personal__theme-choice svg { width: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.6; }
  .personal__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.8rem; }
  .personal__facts div { display: flex; flex-direction: column; gap: 0.3rem; padding-top: 0.9rem; border-top: 1px solid var(--rule); }
  .personal__facts strong { font-size: 1.65rem; font-weight: 600; }
  .personal__facts span { color: var(--mute); font-size: 0.69rem; }

  @media (max-width: 900px) {
    .personal__panel { grid-template-columns: 1fr; }
    .personal__visual { order: 2; }
    .personal__copy { max-width: 42rem; }
  }

  @media (max-width: 560px) {
    .personal__panel { padding: 1.2rem; }
    .personal__copy { padding: 0.8rem 0.25rem; }
    .personal__copy h2 { font-size: clamp(2.5rem, 12vw, 3.45rem); }
    .personal__float { display: none; }
    .personal__visual :global(.product-window), .personal__visual:hover :global(.product-window) { transform: none; }
  }
</style>
