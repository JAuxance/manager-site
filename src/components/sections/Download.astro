---
import { getLatestRelease } from "~/lib/releases";

const release = await getLatestRelease();
const linux = [
  { ext: ".deb", label: "Debian / Ubuntu", href: release.debUrl, sig: release.debSigUrl },
  { ext: ".rpm", label: "Fedora / RHEL", href: release.rpmUrl, sig: release.rpmSigUrl },
  { ext: ".AppImage", label: "Linux portable", href: release.appImageUrl, sig: release.appImageSigUrl },
];
---

<section class="download" id="download" aria-labelledby="download-title">
  <div class="shell">
    <div class="download__cta" data-appear>
      <div class="download__rays" aria-hidden="true"></div>
      <div class="download__logo" aria-hidden="true">
        <svg viewBox="0 0 1024 1024">
          <g><rect x="288" y="272" width="72" height="480" /><rect x="416" y="272" width="72" height="480" /><rect x="544" y="272" width="72" height="480" /><rect x="672" y="272" width="72" height="480" /></g>
          <line x1="232" y1="680" x2="792" y2="420" />
        </svg>
      </div>

      <div class="download__cta-copy">
        <span class="download__eyebrow"><span data-lang="en">Manager {release.version}</span><span data-lang="fr">Manager {release.version}</span></span>
        <h2 id="download-title"><span data-lang="en">Ready to clear the desk?</span><span data-lang="fr">Prêt à libérer le bureau ?</span></h2>
        <p><span data-lang="en">Free for Windows and Linux.</span><span data-lang="fr">Gratuit pour Windows et Linux.</span></p>
      </div>

      <div class="download__cta-actions">
        <a class="download__pc button-shine" href={release.winUrl}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 4.8 10.7 4v7.4H3.5zm8.5-1 8.5-1v8.6H12zM3.5 12.7h7.2V20l-7.2-.8zm8.5 0h8.5v8.5l-8.5-1z" /></svg>
          <span><span data-lang="en">Download for PC</span><span data-lang="fr">Télécharger pour PC</span><small>.exe · x64</small></span>
        </a>
        <a class="download__other" href="#formats">
          <span data-lang="en">Other formats</span><span data-lang="fr">Autres formats</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="download__formats" id="formats" data-appear>
      <header>
        <span class="eyebrow"><span data-lang="en">Install Manager</span><span data-lang="fr">Installer Manager</span></span>
        <p><span data-lang="en">Choose the package for your computer.</span><span data-lang="fr">Choisis le paquet adapté à ton ordinateur.</span></p>
      </header>

      <div class="download__cards">
        <article data-platform-card="windows">
          <div class="download__card-head">
            <span class="download__platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 4.8 10.7 4v7.4H3.5zm8.5-1 8.5-1v8.6H12zM3.5 12.7h7.2V20l-7.2-.8zm8.5 0h8.5v8.5l-8.5-1z" /></svg></span>
            <div><h3>Windows</h3><p>Windows 10 / 11 · x64</p></div>
          </div>
          <a class="download__file" href={release.winUrl}>
            <span><strong>Manager {release.version}</strong><small>.exe installer</small></span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 16h12" /></svg>
          </a>
          {release.winSigUrl && <a class="download__sig" href={release.winSigUrl}>minisign .sig</a>}
        </article>

        <article data-platform-card="linux">
          <div class="download__card-head">
            <span class="download__platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8.5 16c-1.5 1-2.5 2.2-2.5 4h12c0-1.8-1-3-2.5-4M9 12V9.5C9 6.5 10 4 12 4s3 2.5 3 5.5V12M8 16h8v-4H8z" /></svg></span>
            <div><h3>Linux</h3><p>x86_64 · 3 formats</p></div>
          </div>
          <div class="download__linux">
            {linux.map((item) => (
              <div class="download__linux-row">
                <a href={item.href}><span><strong>{item.ext}</strong><small>{item.label}</small></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 16h12" /></svg></a>
                {item.sig && <a class="download__sig" href={item.sig}>.sig</a>}
              </div>
            ))}
          </div>
        </article>
      </div>

      <div class="download__foot">
        <p><span data-lang="en">Signed automatic updates are included. No macOS version is currently available.</span><span data-lang="fr">Les mises à jour automatiques signées sont intégrées. Aucune version macOS n’est disponible actuellement.</span></p>
        <a href={release.htmlUrl} target="_blank" rel="noopener noreferrer"><span data-lang="en">Release details</span><span data-lang="fr">Détails de la version</span> ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .download { padding: var(--section-space) 0 clamp(5rem, 9vw, 8rem); scroll-margin-top: 5rem; }
  .download__cta { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(1.4rem, 3.5vw, 3rem); align-items: center; min-height: 13rem; padding: clamp(1.5rem, 3.4vw, 2.6rem); overflow: hidden; border: 1px solid rgb(255 255 255 / 0.13); border-radius: clamp(1.2rem, 3vw, 2rem); background: linear-gradient(112deg, #0c111c 0%, #111931 52%, #5367e8 140%); box-shadow: 0 2rem 6rem rgb(0 0 0 / 0.28); color: #f7f8fc; isolation: isolate; }
  .download__cta::after { content: ""; position: absolute; inset: 0; z-index: -2; background: radial-gradient(circle at 88% 28%, rgb(121 96 255 / 0.55), transparent 40%), radial-gradient(circle at 70% 120%, rgb(44 112 255 / 0.32), transparent 46%); }
  .download__rays { position: absolute; right: -8rem; bottom: -14rem; z-index: -1; width: 40rem; aspect-ratio: 1; border: 1px solid rgb(255 255 255 / 0.1); border-radius: 50%; box-shadow: 0 0 0 5rem rgb(255 255 255 / 0.022), 0 0 0 10rem rgb(255 255 255 / 0.018); animation: cta-pulse 7s ease-in-out infinite; }
  .download__logo { display: grid; width: clamp(5rem, 8vw, 7.2rem); aspect-ratio: 1; place-items: center; border: 1px solid rgb(255 255 255 / 0.16); border-radius: 1.5rem; background: rgb(6 9 17 / 0.42); box-shadow: 0 1.2rem 3.5rem rgb(0 0 0 / 0.28), 0 0 2.5rem rgb(119 130 255 / 0.18) inset; backdrop-filter: blur(14px); }
  .download__logo svg { width: 58%; overflow: visible; }
  .download__logo g { fill: #fff; }
  .download__logo line { fill: none; stroke: #fff; stroke-width: 48; }
  .download__eyebrow { color: #95a8ff; font-family: var(--font-mono); font-size: 0.62rem; font-weight: 750; letter-spacing: 0.14em; text-transform: uppercase; }
  .download__cta h2 { max-width: 19ch; margin-top: 0.55rem; font-size: clamp(1.75rem, 3.1vw, 2.8rem); line-height: 1.05; }
  .download__cta-copy p { margin-top: 0.65rem; color: #aeb7ca; font-size: 0.77rem; }
  .download__cta-actions { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(12rem, 1fr); gap: 0.55rem; min-width: clamp(13rem, 20vw, 16rem); }
  .download__pc, .download__other { display: flex; align-items: center; justify-content: center; gap: 0.72rem; min-height: 3.2rem; padding: 0.72rem 1rem; border-radius: 0.8rem; font-size: 0.75rem; font-weight: 750; transition: transform var(--dur-press), background var(--dur-fast), border-color var(--dur-fast); }
  .download__pc { background: linear-gradient(105deg, #6582ff, #8768f6); color: #fff; box-shadow: 0 1rem 2.8rem rgb(39 50 128 / 0.35); }
  .download__pc:hover { transform: translateY(-2px); }
  .download__pc svg { width: 1rem; fill: currentColor; }
  .download__pc > span { display: flex; flex-direction: column; gap: 0.05rem; }
  .download__pc small { opacity: 0.65; font-size: 0.57rem; }
  .download__other { border: 1px solid rgb(255 255 255 / 0.11); background: rgb(255 255 255 / 0.055); color: #d7ddeb; }
  .download__other:hover { border-color: rgb(255 255 255 / 0.2); background: rgb(255 255 255 / 0.09); }

  .download__formats { max-width: 64rem; margin: clamp(3rem, 6vw, 4.5rem) auto 0; scroll-margin-top: 6rem; }
  .download__formats > header { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--rule); }
  .download__formats > header p { color: var(--mute); font-size: 0.76rem; }
  .download__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .download__cards article { position: relative; padding: clamp(1.2rem, 3vw, 1.8rem); border: 1px solid var(--rule); border-radius: 1.2rem; background: var(--surface); box-shadow: var(--shadow-soft); transition: border-color var(--dur-base), transform var(--dur-base) var(--ease-out); }
  .download__cards article:hover { transform: translateY(-0.2rem); }
  .download__cards article.is-match { border-color: color-mix(in srgb, var(--accent) 55%, var(--rule)); }
  .download__cards article.is-match::after { content: "Your system"; position: absolute; top: 1.2rem; right: 1.2rem; padding: 0.3rem 0.5rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 0.55rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  :global(html[lang="fr"]) .download__cards article.is-match::after { content: "Ton système"; }
  .download__card-head { display: flex; align-items: center; gap: 0.75rem; }
  .download__platform-icon { display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--rule); border-radius: 0.72rem; color: var(--accent); }
  .download__platform-icon svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.4; }
  .download__cards article:first-child .download__platform-icon svg { fill: currentColor; stroke: none; }
  .download__card-head h3 { font-size: 1rem; }
  .download__card-head p { margin-top: 0.15rem; color: var(--mute); font-size: 0.63rem; }
  .download__file, .download__linux-row > a:first-child { display: flex; align-items: center; justify-content: space-between; min-height: 3.65rem; margin-top: 1.25rem; padding: 0.75rem 0.85rem; border-radius: 0.7rem; background: var(--inverse); color: var(--inverse-ink); transition: background var(--dur-fast), transform var(--dur-press); }
  .download__file:hover, .download__linux-row > a:first-child:hover { background: linear-gradient(105deg, #526fff, #8064ed); }
  .download__file:active, .download__linux-row > a:first-child:active { transform: scale(0.99); }
  .download__file > span, .download__linux-row > a:first-child > span { display: flex; flex-direction: column; gap: 0.1rem; }
  .download__file strong, .download__linux-row strong { font-size: 0.78rem; }
  .download__file small, .download__linux-row small { opacity: 0.62; font-size: 0.58rem; }
  .download__file svg, .download__linux-row svg { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .download__sig { display: inline-block; margin-top: 0.6rem; color: var(--mute); font-family: var(--font-mono); font-size: 0.57rem; text-decoration: underline; text-underline-offset: 3px; }
  .download__linux { margin-top: 0.85rem; }
  .download__linux-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.55rem; align-items: center; }
  .download__linux-row > a:first-child { min-height: 3rem; margin-top: 0.4rem; background: var(--surface-2); color: var(--ink); }
  .download__linux-row > a:first-child:hover { background: var(--accent-soft); color: var(--ink); }
  .download__linux-row .download__sig { margin: 0; }
  .download__foot { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 1rem; color: var(--mute); font-size: 0.62rem; line-height: 1.5; }
  .download__foot a { flex: 0 0 auto; text-decoration: underline; text-underline-offset: 3px; }

  @keyframes cta-pulse { 0%, 100% { opacity: 0.65; transform: scale(0.96); } 50% { opacity: 1; transform: scale(1.04); } }

  @media (max-width: 820px) {
    .download__cta { grid-template-columns: auto 1fr; }
    .download__cta-actions { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .download__cta { grid-template-columns: 1fr; text-align: center; }
    .download__logo { margin-inline: auto; }
    .download__cta-actions { grid-column: auto; grid-template-columns: 1fr; }
    .download__cards { grid-template-columns: 1fr; }
    .download__formats > header, .download__foot { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) { .download__rays { animation: none; } }
</style>
