---
import LangToggle from "~/components/LangToggle.astro";
import ThemeToggle from "~/components/ThemeToggle.astro";
import { getLatestRelease } from "~/lib/releases";

const release = await getLatestRelease();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__top">
      <a class="footer__brand" href="#top" aria-label="Manager — accueil">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v16M10 3v16M14 3v16M18 3v16M3 17l18-7" /></svg></span>
        <div><strong>Manager</strong><small>v{release.version}</small></div>
      </a>

      <nav class="footer__nav" aria-label="Footer navigation / Navigation du pied de page">
        <a href="#features"><span data-lang="en">Features</span><span data-lang="fr">Fonctionnalités</span></a>
        <a href="#overview"><span data-lang="en">Overview</span><span data-lang="fr">Aperçu</span></a>
        <a href="#download"><span data-lang="en">Download</span><span data-lang="fr">Télécharger</span></a>
        <a href="https://github.com/JAuxance/manager-releases" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>

      <div class="footer__settings"><ThemeToggle /><LangToggle variant="inline" /></div>
    </div>

    <div class="footer__bottom">
      <span>© {year} Manager · Windows & Linux</span>
      <div>
        <a href="/mentions-legales"><span data-lang="en">Legal</span><span data-lang="fr">Mentions légales</span></a>
        <a href="/confidentialite"><span data-lang="en">Privacy</span><span data-lang="fr">Confidentialité</span></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 2rem 0; border-top: 1px solid var(--rule); background: var(--paper-sunk); }
  .footer__top { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; align-items: center; }
  .footer__brand { display: inline-flex; align-items: center; justify-self: start; gap: 0.72rem; }
  .footer__brand > span { display: grid; width: 2.3rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--rule); border-radius: 0.7rem; background: var(--surface); }
  .footer__brand svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .footer__brand div { display: flex; flex-direction: column; }
  .footer__brand strong { font-size: 0.86rem; }
  .footer__brand small { color: var(--mute-soft); font-size: 0.58rem; }
  .footer__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.4rem; }
  .footer__nav a { color: var(--mute); font-size: 0.68rem; font-weight: 650; transition: color var(--dur-fast); }
  .footer__nav a:hover { color: var(--ink); }
  .footer__settings { display: flex; align-items: center; justify-self: end; gap: 0.55rem; }
  .footer__bottom { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid var(--rule); color: var(--mute-soft); font-size: 0.6rem; }
  .footer__bottom > div { display: flex; gap: 1rem; }
  .footer__bottom a:hover { color: var(--ink); }

  @media (max-width: 760px) {
    .footer__top { grid-template-columns: 1fr auto; }
    .footer__nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; }
  }

  @media (max-width: 480px) {
    .footer__bottom { flex-direction: column; }
  }
</style>
