---
import ProductWindow from "~/components/ProductWindow.astro";
---

<section class="tour" id="experience" aria-labelledby="tour-title" data-tour>
  <div class="shell">
    <header class="tour__head" data-appear>
      <span class="eyebrow"><span data-lang="en">Inside Manager</span><span data-lang="fr">Dans Manager</span></span>
      <h2 id="tour-title">
        <span data-lang="en">Every screen. <em class="gradient-text">One rhythm.</em></span>
        <span data-lang="fr">Chaque écran. <em class="gradient-text">Un même rythme.</em></span>
      </h2>
      <p><span data-lang="en">Choose a screen to explore the real app.</span><span data-lang="fr">Choisis un écran pour explorer la vraie application.</span></p>
    </header>

    <div class="tour__body theme-surface" data-appear>
      <div class="tour__tabs" role="tablist" aria-label="Manager screens / Écrans Manager">
        <button class="is-active" type="button" role="tab" id="tab-focus" aria-selected="true" aria-controls="panel-focus" tabindex="0" data-tour-tab="focus">
          <span class="tour__tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M18 6 20 4" /></svg></span>
          <span class="tour__tab-copy"><strong>Focus</strong><small><span data-lang="en">Start a session, keep the target visible.</span><span data-lang="fr">Lance une session, garde l’objectif visible.</span></small></span>
          <span class="tour__tab-arrow" aria-hidden="true">↗</span>
        </button>

        <button type="button" role="tab" id="tab-tasks" aria-selected="false" aria-controls="panel-tasks" tabindex="-1" data-tour-tab="tasks">
          <span class="tour__tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 7 2 2 3-4M12 7h8M4 14l2 2 3-4M12 14h8M12 20h8" /></svg></span>
          <span class="tour__tab-copy"><strong><span data-lang="en">Tasks</span><span data-lang="fr">Tâches</span></strong><small><span data-lang="en">Prioritize today and prepare tomorrow.</span><span data-lang="fr">Priorise aujourd’hui et prépare demain.</span></small></span>
          <span class="tour__tab-arrow" aria-hidden="true">↗</span>
        </button>

        <button type="button" role="tab" id="tab-schedule" aria-selected="false" aria-controls="panel-schedule" tabindex="-1" data-tour-tab="schedule">
          <span class="tour__tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /></svg></span>
          <span class="tour__tab-copy"><strong><span data-lang="en">Schedule</span><span data-lang="fr">Planning</span></strong><small><span data-lang="en">Shape a reusable week, block by block.</span><span data-lang="fr">Compose une semaine réutilisable, bloc par bloc.</span></small></span>
          <span class="tour__tab-arrow" aria-hidden="true">↗</span>
        </button>

        <button type="button" role="tab" id="tab-journal" aria-selected="false" aria-controls="panel-journal" tabindex="-1" data-tour-tab="journal">
          <span class="tour__tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4h11a2 2 0 0 1 2 2v14H8a2 2 0 0 1-2-2zM6 4v14a2 2 0 0 0 2 2M10 9h5M10 13h5" /></svg></span>
          <span class="tour__tab-copy"><strong>Journal</strong><small><span data-lang="en">Keep a private trace of the day.</span><span data-lang="fr">Garde une trace privée de la journée.</span></small></span>
          <span class="tour__tab-arrow" aria-hidden="true">↗</span>
        </button>

        <button type="button" role="tab" id="tab-appearance" aria-selected="false" aria-controls="panel-appearance" tabindex="-1" data-tour-tab="appearance">
          <span class="tour__tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" /></svg></span>
          <span class="tour__tab-copy"><strong><span data-lang="en">Appearance</span><span data-lang="fr">Apparence</span></strong><small><span data-lang="en">Follow the system or choose your mode.</span><span data-lang="fr">Suis le système ou choisis ton mode.</span></small></span>
          <span class="tour__tab-arrow" aria-hidden="true">↗</span>
        </button>
      </div>

      <div class="tour__stage" aria-live="polite">
        <div class="tour__halo" aria-hidden="true"></div>
        <div class="tour__panel is-active" id="panel-focus" role="tabpanel" aria-labelledby="tab-focus" aria-hidden="false" data-tour-panel="focus">
          <ProductWindow
            src="/screenshots/focus.png"
            altEn="Manager Focus screen with a 25-minute timer, presets and completed session history."
            altFr="Écran Focus de Manager avec un chronomètre de 25 minutes, les préréglages et l’historique des sessions."
            captionId="tour-focus"
          />
        </div>
        <div class="tour__panel" id="panel-tasks" role="tabpanel" aria-labelledby="tab-tasks" aria-hidden="true" data-tour-panel="tasks">
          <ProductWindow
            src="/screenshots/tasks.png"
            altEn="Manager Tasks screen with realistic tasks, completion progress, priorities and recurring tasks."
            altFr="Écran Tâches de Manager avec la progression, les priorités et une tâche récurrente."
            captionId="tour-tasks"
          />
        </div>
        <div class="tour__panel" id="panel-schedule" role="tabpanel" aria-labelledby="tab-schedule" aria-hidden="true" data-tour-panel="schedule">
          <ProductWindow
            src="/screenshots/schedule.png"
            altEn="Manager weekly Schedule screen with colored work blocks arranged through the day."
            altFr="Planning hebdomadaire de Manager avec des blocs de travail colorés répartis dans la journée."
            captionId="tour-schedule"
          />
        </div>
        <div class="tour__panel" id="panel-journal" role="tabpanel" aria-labelledby="tab-journal" aria-hidden="true" data-tour-panel="journal">
          <ProductWindow
            src="/screenshots/journal.png"
            altEn="Manager Journal screen with a writing area, mood selection and previous entries."
            altFr="Journal de Manager avec une zone d’écriture, le choix de l’humeur et les entrées précédentes."
            captionId="tour-journal"
          />
        </div>
        <div class="tour__panel" id="panel-appearance" role="tabpanel" aria-labelledby="tab-appearance" aria-hidden="true" data-tour-panel="appearance">
          <ProductWindow
            src="/screenshots/themes.png"
            altEn="Manager Settings showing system, light and dark appearances, four accent themes and interface density."
            altFr="Réglages de Manager avec les apparences système, claire et sombre, quatre accents et la densité de l’interface."
            captionId="tour-appearance"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tour { position: relative; padding: var(--section-space) 0; overflow: clip; scroll-margin-top: 5rem; }
  .tour::before { content: ""; position: absolute; top: 16%; left: -24rem; z-index: -1; width: 62rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 11%, transparent), transparent 68%); filter: blur(2.5rem); }
  .tour__head { max-width: 54rem; margin-inline: auto; text-align: center; }
  .tour__head .eyebrow::before { display: none; }
  .tour__head h2 { max-width: 14ch; margin: 1.3rem auto 0; font-size: var(--display-3); }
  .tour__head h2 em { display: block; font-style: normal; }
  .tour__head > p { margin-top: 1.25rem; color: var(--mute); font-size: 0.9rem; }

  .tour__body { display: grid; grid-template-columns: minmax(17rem, 0.34fr) minmax(0, 0.66fr); gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: clamp(2.7rem, 6vw, 4.7rem); padding: clamp(1rem, 2.8vw, 2rem); border: 1px solid var(--rule); border-radius: clamp(1.25rem, 3vw, 2rem); background: linear-gradient(145deg, var(--surface), color-mix(in srgb, var(--surface-2) 60%, transparent)); box-shadow: var(--shadow-soft); }
  .tour__tabs { display: grid; align-content: center; gap: 0.45rem; }
  .tour__tabs button { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.85rem; align-items: center; width: 100%; min-height: 5.6rem; padding: 0.85rem; border: 1px solid transparent; border-radius: 1rem; color: var(--mute); text-align: left; transition: color var(--dur-fast) var(--ease-out), background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .tour__tabs button:hover { color: var(--ink); background: var(--surface-hover); }
  .tour__tabs button.is-active { border-color: color-mix(in srgb, var(--accent) 24%, var(--rule)); background: var(--accent-soft); color: var(--ink); }
  .tour__tabs button:active { transform: scale(0.99); }
  .tour__tab-icon { display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--rule); border-radius: 0.75rem; background: var(--surface-glass); color: var(--accent); }
  .tour__tab-icon svg { width: 1.2rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
  .tour__tab-copy { display: flex; min-width: 0; flex-direction: column; gap: 0.25rem; }
  .tour__tab-copy strong { color: currentColor; font-size: 0.87rem; }
  .tour__tab-copy small { color: var(--mute); font-size: 0.67rem; line-height: 1.45; }
  .tour__tab-arrow { opacity: 0; color: var(--accent); font-size: 0.8rem; transform: translate(-0.3rem, 0.3rem); transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .tour__tabs button.is-active .tour__tab-arrow { opacity: 1; transform: none; }

  .tour__stage { position: relative; min-width: 0; align-self: center; aspect-ratio: 1.44; perspective: 1200px; }
  .tour__halo { position: absolute; inset: 12% 4% 4%; border-radius: 50%; background: color-mix(in srgb, var(--accent) 13%, transparent); filter: blur(4rem); transition: background 500ms var(--ease-out); }
  .tour__panel { position: absolute; inset: 50% 0 auto; opacity: 0; visibility: hidden; pointer-events: none; transform: translate3d(1.2rem, -47%, 0) rotateY(-2deg) scale(0.985); transition: opacity 360ms var(--ease-out), transform 540ms var(--ease-out), visibility 0s linear 540ms; }
  .tour__panel.is-active { opacity: 1; visibility: visible; pointer-events: auto; transform: translate3d(0, -50%, 0) rotateY(0) scale(1); transition-delay: 70ms, 70ms, 0s; }
  .tour__panel :global(.product-window) { box-shadow: 0 2.5rem 7rem rgb(0 0 0 / 0.48); }

  @media (max-width: 900px) {
    .tour__body { grid-template-columns: 1fr; }
    .tour__tabs { grid-template-columns: repeat(5, minmax(0, 1fr)); align-content: normal; }
    .tour__tabs button { grid-template-columns: auto 1fr; min-height: 4rem; }
    .tour__tab-copy small, .tour__tab-arrow { display: none; }
    .tour__stage { aspect-ratio: 1.45; }
  }

  @media (max-width: 620px) {
    .tour__body { padding: 0.65rem; border-radius: 1.2rem; }
    .tour__tabs { display: flex; gap: 0.35rem; overflow-x: auto; scrollbar-width: none; }
    .tour__tabs::-webkit-scrollbar { display: none; }
    .tour__tabs button { flex: 0 0 auto; grid-template-columns: auto auto; width: auto; min-height: 3.15rem; padding: 0.45rem 0.65rem; border-radius: 0.8rem; }
    .tour__tab-icon { width: 2rem; }
    .tour__tab-copy strong { font-size: 0.74rem; }
    .tour__stage { aspect-ratio: 1.34; margin: 0.3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tour__panel, .tour__panel.is-active { transition: none; transform: translateY(-50%); }
  }
</style>
