---
import ProductWindow from "~/components/ProductWindow.astro";
---

<section class="focus" id="features">
  <div class="shell focus__inner">
    <header class="focus__copy" data-appear>
      <span class="eyebrow">
        <span data-lang="en">01 · Focus</span>
        <span data-lang="fr">01 · Se concentrer</span>
      </span>
      <h2 class="section-title">
        <span data-lang="en">Time finds its place again.</span>
        <span data-lang="fr">Le temps retrouve sa place.</span>
      </h2>
      <p class="section-copy">
        <span data-lang="en">Choose a rhythm, name what deserves your attention, then start. Manager keeps the session visible and the rest of the day quiet.</span>
        <span data-lang="fr">Choisis un rythme, nomme ce qui mérite ton attention, puis commence. Manager garde la session visible et le reste de la journée au calme.</span>
      </p>
    </header>

    <div class="focus__facts" data-appear>
      <div><strong>25</strong><span data-lang="en">minutes, by default</span><span data-lang="fr">minutes, par défaut</span></div>
      <div><strong>4</strong><span data-lang="en">built-in rhythms</span><span data-lang="fr">rythmes intégrés</span></div>
      <div><strong>1</strong><span data-lang="en">thing at a time</span><span data-lang="fr">chose à la fois</span></div>
    </div>

    <div class="focus__stage" data-appear>
      <ProductWindow
        src="/screenshots/focus.png"
        altEn="Manager Focus screen with a 25 minute timer, task types, presets and completed session history."
        altFr="Écran Focus de Manager avec un chronomètre de 25 minutes, les types de tâches, les préréglages et l’historique des sessions."
      />
      <aside class="focus__card" aria-hidden="true">
        <span data-lang="en">Current session</span>
        <span data-lang="fr">Session en cours</span>
        <strong>25:00</strong>
        <small>Design · 1/4</small>
      </aside>
    </div>
  </div>
</section>

<style>
  .focus {
    padding: var(--section-space) 0;
    background: linear-gradient(180deg, transparent, rgb(11 15 25 / 0.84) 18%, rgb(11 15 25 / 0.84) 82%, transparent);
  }

  .focus__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .focus__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    padding-bottom: 0.7rem;
  }

  .focus__facts div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .focus__facts strong {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 400;
    line-height: 1;
  }

  .focus__facts span { color: var(--mute); font-size: 0.76rem; line-height: 1.35; }

  .focus__stage {
    position: relative;
    grid-column: 1 / -1;
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .focus__card {
    position: absolute;
    right: -2rem;
    bottom: -2rem;
    display: flex;
    flex-direction: column;
    width: 11rem;
    padding: 1.2rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius);
    background: rgb(15 20 33 / 0.9);
    box-shadow: 0 1.4rem 3.5rem rgb(0 0 0 / 0.4);
    backdrop-filter: blur(18px);
  }

  .focus__card > span { color: var(--mute); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .focus__card strong { margin-top: 0.7rem; font-family: var(--font-serif); font-size: 2.3rem; font-weight: 400; line-height: 1; }
  .focus__card small { margin-top: 0.5rem; color: var(--mute); }

  @media (max-width: 860px) {
    .focus__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .focus__facts { max-width: 36rem; }
    .focus__stage { grid-column: auto; margin-top: 0; }
    .focus__card { display: none; }
  }

  @media (max-width: 540px) {
    .focus__facts { gap: 1rem; }
    .focus__facts strong { font-size: 2rem; }
  }
</style>
