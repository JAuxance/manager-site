<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Light / dark mode"
>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.2" />
    <path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M18.5 5.5l-1.4 1.4M6.9 17.1l-1.4 1.4" />
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.2 8.2 0 1 0 11.2 11.2Z" />
  </svg>
  <span class="visually-hidden">
    <span data-lang="en">Change color mode</span>
    <span data-lang="fr">Changer le mode de couleur</span>
  </span>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    width: 2.55rem;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface-glass);
    color: var(--mute);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-base) var(--ease-out),
      transform var(--dur-press) var(--ease-out);
  }

  .theme-toggle:hover { border-color: var(--rule-strong); color: var(--ink); }
  .theme-toggle:active { transform: scale(0.94); }
  .theme-toggle svg {
    position: absolute;
    width: 1.08rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    transition: opacity 260ms var(--ease-out), transform 420ms var(--ease-out);
  }

  .theme-toggle__sun { opacity: 0; transform: rotate(-70deg) scale(0.65); }
  .theme-toggle__moon { opacity: 1; transform: rotate(0) scale(1); }
  :global(html[data-theme="light"]) .theme-toggle__sun { opacity: 1; transform: rotate(0) scale(1); }
  :global(html[data-theme="light"]) .theme-toggle__moon { opacity: 0; transform: rotate(70deg) scale(0.65); }
</style>
